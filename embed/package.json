{
  "name": "ziscus",
  "version": "0.7.0",
  "description": "Zero-JavaScript anonymous comment system \u2014 Cloudflare Worker, static HTML/CSS renderers, and CLI for static sites",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ziscus": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./schema.sql": "./dist/schema.sql"
  },
  "scripts": {
    "build": "pnpm --filter ziscus-worker build && tsdown && node scripts/bundle-worker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "comments",
    "zero-javascript",
    "anonymous",
    "static-site",
    "moderation",
    "anti-spam",
    "cloudflare-workers",
    "d1"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HectorZarate/ziscus.git",
    "directory": "embed"
  },
  "homepage": "https://ziscus.com",
  "bugs": "https://github.com/HectorZarate/ziscus/issues",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsdown": "^0.12.0",
    "typescript": "^5.9.0",
    "vitest": "~3.0.9"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  }
}
